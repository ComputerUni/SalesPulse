@using SalesPulse.Core.DTOs.SalesIntelligenceDtos
@using System.Globalization
@model CohortMatrixDto

@{
    var tr = new CultureInfo("tr-TR");

    var monthNames = new[]
    {
        "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
        "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"
    };

    string GetCellClass(decimal? rate)
    {
        if (!rate.HasValue)
            return "bg-surface-container-low text-outline font-normal";

        var val = rate.Value;

        if (val >= 99.0m)
            return "bg-primary text-on-primary font-bold";
        if (val >= 45.0m)
            return "bg-primary-container text-on-primary font-bold";
        if (val >= 38.0m)
            return "bg-primary-fixed text-primary font-bold";
        if (val >= 32.0m)
            return "bg-primary-fixed/80 text-on-surface font-semibold";
        if (val >= 28.0m)
            return "bg-secondary-fixed text-secondary font-semibold";
        if (val >= 20.0m)
            return "bg-tertiary-fixed text-tertiary font-semibold";

        return "bg-surface-container-low text-on-surface-variant font-medium";
    }
}

<div class="flex items-center justify-between mb-2">
    <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#13C2C2]"></span>
        <h2 class="font-title-sm text-title-sm text-on-surface">Tekrar Eden Alışveriş</h2>
    </div>
    <span class="font-label-caps text-label-caps px-2 py-0.5 rounded bg-surface-container-low text-outline uppercase font-semibold">
        Müşteri Sadakati (%)
    </span>
</div>

<div class="overflow-x-auto pb-2 scroll-smooth">
    <table class="w-full min-w-[860px] text-center border-separate border-spacing-1 font-data-table text-body-sm">
        <thead>
            <tr class="font-label-caps text-label-caps text-outline">
                <th class="sticky left-0 bg-surface-container-lowest z-10 text-left font-normal pb-2 px-2 whitespace-nowrap min-w-[130px]">
                    Kohort
                </th>
                <th class="pb-2 px-2 whitespace-nowrap min-w-[70px]">
                    Kullanıcı
                </th>
                @foreach (var monthTitle in monthNames)
                {
                    <th class="pb-2 whitespace-nowrap min-w-[55px]">
                        @monthTitle
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows != null && Model.Rows.Any())
            {
                foreach (var row in Model.Rows)
                {
                    var cohortMonth = row.CohortDate.Month; 

                    <tr>
                        <td class="sticky left-0 bg-surface-container-lowest z-10 text-left font-semibold text-on-surface px-2 py-1.5 font-body-sm whitespace-nowrap capitalize">
                            @row.CohortName
                        </td>

                        <td class="text-on-surface-variant text-xs font-semibold px-2 py-1.5 whitespace-nowrap">
                            @row.InitialCustomers.ToString("N0", tr)
                        </td>

                        @for (int colMonth = 1; colMonth <= 12; colMonth++)
                        {
                            decimal? rate = null;


                            if (colMonth >= cohortMonth)
                            {
                                int relativeIndex = colMonth - cohortMonth;
                                row.RetentionRates.TryGetValue(relativeIndex, out rate);
                            }

                            var cellClass = GetCellClass(rate);
                            var targetMonthName = monthNames[colMonth - 1];

                            <td class="p-2 rounded text-xs whitespace-nowrap transition-transform duration-100 hover:scale-[1.03] cursor-default @cellClass"
                                title="@(rate.HasValue ? $"{row.CohortName} kohortunun {targetMonthName} ayı sadakat oranı: %{rate.Value.ToString("F1", tr)}" : "-")">
                                @(rate.HasValue ? (rate.Value >= 99.9m ? "100%" : $"%{rate.Value.ToString("F1", tr)}") : "-")
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="14" class="py-8 text-center text-outline font-body-sm">
                        Seçilen tarih aralığında kohort verisi bulunamadı.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>