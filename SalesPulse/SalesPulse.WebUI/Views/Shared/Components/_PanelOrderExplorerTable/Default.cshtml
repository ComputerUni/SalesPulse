@using SalesPulse.Core.DTOs.Common
@using SalesPulse.Core.DTOs.OrderExplorerDtos
@model PagedResult<OrderExplorerListItemDto>

@{
    var startItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

<div class="col-span-12 xl:col-span-12 2xl:col-span-12 flex flex-col">
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden flex flex-col">
        <!-- Table Control Toolbar -->
        <div class="px-space-lg py-space-md bg-surface-container-low/50 flex flex-wrap items-center justify-between gap-space-sm border-b border-surface-container-low">
            <div class="flex items-center gap-space-sm">
                <span class="font-title-sm text-body-md text-on-surface font-semibold">Tüm Sonuçlar</span>
                <span class="px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant font-data-table text-body-sm">
                    @Model.Items.Count() / @Model.TotalCount.ToString("N0")
                </span>
            </div>
            <div class="flex items-center gap-space-xs text-on-surface-variant">
                <button class="p-1.5 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" title="Toplu İşlem: Fatura Yazdır">
                    <span class="material-symbols-outlined text-[18px]">print</span>
                </button>
                <button class="p-1.5 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" title="Toplu İşlem: Kargoya Ata">
                    <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                </button>
                <button class="p-1.5 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" title="Sütunları Düzenle">
                    <span class="material-symbols-outlined text-[18px]">view_column</span>
                </button>
            </div>
        </div>

        <!-- High-Density Responsive Table View -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/70 text-outline border-b border-surface-container-high select-none">
                        <th class="py-3 px-3 w-10 text-center">
                            <input class="rounded accent-primary cursor-pointer w-4 h-4" type="checkbox" />
                        </th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider cursor-pointer hover:text-primary">
                            <div class="flex items-center gap-1">
                                <span>Sipariş No</span>
                                <span class="material-symbols-outlined text-[14px]">swap_vert</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider cursor-pointer hover:text-primary">
                            <div class="flex items-center gap-1">
                                <span>Müşteri</span>
                                <span class="material-symbols-outlined text-[14px]">swap_vert</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider">Şehir</th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider cursor-pointer hover:text-primary">
                            <div class="flex items-center gap-1">
                                <span>Tarih &amp; Saat</span>
                                <span class="material-symbols-outlined text-[14px] text-primary">arrow_downward</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider text-right cursor-pointer hover:text-primary">
                            <div class="flex items-center justify-end gap-1">
                                <span>Tutar</span>
                                <span class="material-symbols-outlined text-[14px]">swap_vert</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider text-center">Ödeme</th>
                        <th class="py-3 px-3 font-label-caps text-label-caps uppercase tracking-wider text-center">Durum</th>
                        <th class="py-3 px-4 font-label-caps text-label-caps uppercase tracking-wider text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-low text-on-surface">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isCancelled = item.Status?.Trim() == "İptal Edildi";
                            var initials = $"{(!string.IsNullOrEmpty(item.FirstName) ? item.FirstName[0].ToString() : "")}{(!string.IsNullOrEmpty(item.LastName) ? item.LastName[0].ToString() : "")}".ToUpper();

                            <tr class="hover:bg-surface-container-low/60 transition-colors group cursor-pointer" onclick="openDrawer('@item.OrderCode')">
                                <td class="py-3.5 px-3 text-center" onclick="event.stopPropagation()">
                                    <input class="rounded accent-primary cursor-pointer w-4 h-4" type="checkbox" />
                                </td>
                                <td class="py-3.5 px-3 font-data-table text-data-table font-semibold text-on-surface">
                                    <div class="flex items-center gap-1.5">
                                        <span>#@item.OrderCode</span>
                                        <button class="opacity-0 group-hover:opacity-100 text-outline hover:text-primary" onclick="copyToClipboard('#@item.OrderCode', event)" title="Kopyala">
                                            <span class="material-symbols-outlined text-[14px]">content_copy</span>
                                        </button>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-surface-container-highest text-primary font-title-sm text-body-sm font-semibold flex items-center justify-center shrink-0">
                                            @initials
                                        </div>

                                        <div class="flex flex-col min-w-0">
                                            <span class="font-title-sm text-body-sm font-semibold text-on-surface truncate">@item.FirstName @item.LastName</span>
                                            <span class="font-body-sm text-body-sm text-outline truncate">@item.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3">
                                    <span class="inline-flex items-center gap-1 font-body-sm text-body-sm text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[14px] text-outline">pin_drop</span>
                                        @item.City
                                    </span>
                                </td>
                                <td class="py-3.5 px-3 font-data-table text-body-sm text-on-surface-variant whitespace-nowrap">
                                    @item.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </td>
                                <td class="py-3.5 px-3 font-data-table text-body-sm font-bold text-right whitespace-nowrap @(isCancelled ? "text-outline line-through" : "text-on-surface")">
                                    ₺@item.TotalAmount.ToString("N2")
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    <span class="font-label-caps text-label-caps px-2 py-0.5 rounded-md bg-secondary-fixed text-on-secondary-fixed font-semibold">
                                        @item.PaymentMethod
                                    </span>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    @if (item.Status == "Tamamlandı" || item.Status == "Teslim Edildi")
                                    {
                                        <span class="inline-flex items-center gap-1 font-label-caps text-label-caps px-2.5 py-1 rounded-full bg-[#D5F5E3] text-[#145A32] font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#27AE60]"></span>
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == "Kargoda")
                                    {
                                        <span class="inline-flex items-center gap-1 font-label-caps text-label-caps px-2.5 py-1 rounded-full bg-[#E1F0FF] text-[#0A58CA] font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#0D6EFD]"></span>
                                            Kargoda
                                        </span>
                                    }
                                    else if (item.Status == "Beklemede")
                                    {
                                        <span class="inline-flex items-center gap-1 font-label-caps text-label-caps px-2.5 py-1 rounded-full bg-[#FFF0E6] text-[#C05621] font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#DD6B20]"></span>
                                            Beklemede
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 font-label-caps text-label-caps px-2.5 py-1 rounded-full bg-[#F3E8FF] text-[#6B21A8] font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#9333EA]"></span>
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right" onclick="event.stopPropagation()">
                                    <div class="flex items-center justify-end gap-1">
                                        <button class="p-1 rounded text-primary hover:bg-surface-container" onclick="openDrawer('@item.OrderCode')" title="Detayı İncele">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                        <button class="p-1 rounded text-outline hover:text-on-surface hover:bg-surface-container" title="Yazdır">
                                            <span class="material-symbols-outlined text-[18px]">receipt</span>
                                        </button>
                                        <button class="p-1 rounded text-outline hover:text-on-surface hover:bg-surface-container" title="Daha Fazla">
                                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="py-12 text-center text-outline font-body-md">
                                Gösterilecek sipariş kaydı bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Enterprise Server-Side Pagination Bar -->
        <div class="px-space-lg py-space-md bg-surface-container-low/40 flex flex-col sm:flex-row items-center justify-between gap-space-md border-t border-surface-container-low">
            <!-- Left Info & Page Size -->
            <div class="flex items-center gap-space-md">
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                    Toplam <span class="font-data-table font-semibold text-on-surface">@Model.TotalCount.ToString("N0")</span> sonuçtan
                    <span class="font-data-table font-semibold text-on-surface">@startItem.ToString("N0") - @endItem.ToString("N0")</span> arası listeleniyor
                </span>
                <div class="flex items-center gap-1.5">
                    <span class="font-label-caps text-label-caps uppercase text-outline">Sayfa Başı:</span>
                    <select onchange="window.location.href='?page=1&pageSize=' + this.value" class="py-1 px-2 rounded-lg bg-surface-container-lowest text-on-surface text-body-sm font-data-table border-0 shadow-xs focus:ring-1 focus:ring-primary cursor-pointer">
                        <!option value="25" @(Model.PageSize == 25 ? "selected" : "")>25</!option>
                        <!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50</!option>
                        <!option value="100" @(Model.PageSize == 100 ? "selected" : "")>100</!option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-1">
                @if (Model.Page > 1)
                {
                    <a href="?page=@(Model.Page - 1)&pageSize=@Model.PageSize" class="p-1.5 rounded-lg bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors shadow-xs flex items-center justify-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                }
                else
                {
                    <button class="p-1.5 rounded-lg bg-surface-container-lowest text-outline shadow-xs opacity-40 cursor-not-allowed flex items-center justify-center" disabled>
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                }

                @if (Model.Page == 1)
                {
                    <span class="w-8 h-8 rounded-lg font-data-table text-body-sm font-semibold bg-primary-container text-on-primary shadow-xs flex items-center justify-center">1</span>
                }
                else
                {
                    <a href="?page=1&pageSize=@Model.PageSize" class="w-8 h-8 rounded-lg font-data-table text-body-sm text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center">1</a>
                }

                @if (Model.Page > 3)
                {
                    <span class="px-1 text-outline font-data-table">...</span>
                }

                @for (int p = Math.Max(2, Model.Page - 1); p <= Math.Min(Model.TotalPages - 1, Model.Page + 1); p++)
                {
                    if (p == Model.Page)
                    {
                        <span class="w-8 h-8 rounded-lg font-data-table text-body-sm font-semibold bg-primary-container text-on-primary shadow-xs flex items-center justify-center">@p</span>
                    }
                    else
                    {
                        <a href="?page=@p&pageSize=@Model.PageSize" class="w-8 h-8 rounded-lg font-data-table text-body-sm text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center">@p</a>
                    }
                }

                @if (Model.Page < Model.TotalPages - 2)
                {
                    <span class="px-1 text-outline font-data-table">...</span>
                }

                @if (Model.TotalPages > 1)
                {
                    if (Model.Page == Model.TotalPages)
                    {
                        <span class="px-2 h-8 rounded-lg font-data-table text-body-sm font-semibold bg-primary-container text-on-primary shadow-xs flex items-center justify-center">@Model.TotalPages.ToString("N0")</span>
                    }
                    else
                    {
                        <a href="?page=@Model.TotalPages&pageSize=@Model.PageSize" class="px-2 h-8 rounded-lg font-data-table text-body-sm text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center">@Model.TotalPages.ToString("N0")</a>
                    }
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a href="?page=@(Model.Page + 1)&pageSize=@Model.PageSize" class="p-1.5 rounded-lg bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors shadow-xs flex items-center justify-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                }
                else
                {
                    <button class="p-1.5 rounded-lg bg-surface-container-lowest text-outline shadow-xs opacity-40 cursor-not-allowed flex items-center justify-center" disabled>
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>