@using SalesPulse.Core.DTOs.SalesIntelligenceDtos
@using System.Globalization
@model List<TopRevenueProductDto>

@{
    var tr = new CultureInfo("tr-TR");

    var badgeThemes = new[]
    {
        "text-primary bg-primary-fixed",
        "text-secondary bg-secondary-fixed",
        "text-tertiary bg-tertiary-fixed",
        "text-[#08979C] bg-[#E6FFFB]",
        "text-[#D46B08] bg-[#FFF0E6]"
    };
}

<div class="lg:col-span-5 bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
    <div>
        <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-tertiary shrink-0"></span>
                <h2 class="font-title-sm text-title-sm text-on-surface">5 Yıldız Ürün Portföyü</h2>
            </div>
            <span class="font-label-caps text-label-caps px-2 py-0.5 rounded bg-tertiary-fixed text-tertiary uppercase font-semibold">
                En Çok Ciro
            </span>
        </div>

        <p class="font-body-sm text-body-sm text-on-surface-variant mb-4">
            Seçilen dönemde ciro hacmi ve satış adedi en yüksek lider ürünler.
        </p>

        <div class="flex flex-col gap-3">
            @if (Model != null && Model.Any())
            {
                for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    var badgeStyle = badgeThemes[i % badgeThemes.Length];

                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-surface-container-low/60 hover:bg-surface-container-low transition-colors">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center shrink-0 border border-outline/10 text-on-surface-variant">
                                <span class="material-symbols-outlined text-[24px]">inventory_2</span>
                            </div>

                            <div class="min-w-0">
                                <h3 class="font-body-sm text-body-sm font-bold text-on-surface truncate" title="@item.ProductName">
                                    @item.ProductName
                                </h3>
                                <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                    <span class="font-data-table text-[11px] text-outline truncate max-w-[120px]" title="@item.CategoryName">
                                        @item.CategoryName
                                    </span>
                                    <span class="font-label-caps text-[10px] @badgeStyle px-1.5 py-0.2 rounded font-semibold whitespace-nowrap">
                                        %@item.RevenueSharePercentage.ToString("F1", tr) Ciro Payı
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="text-right shrink-0 ml-3">
                            <div class="font-data-table text-body-sm font-bold text-on-surface whitespace-nowrap">
                                ₺@item.TotalRevenue.ToString("N0", tr)
                            </div>
                            <span class="font-label-caps text-[11px] text-outline font-semibold flex items-center justify-end gap-0.5 whitespace-nowrap mt-0.5">
                                <span class="material-symbols-outlined text-[13px] text-primary">shopping_bag</span>
                                @item.TotalQuantitySold.ToString("N0", tr) Adet
                            </span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-10 text-center text-outline font-body-sm">
                    Seçilen tarih kriterine uygun ürün verisi bulunamadı.
                </div>
            }
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        var top5Total = Model.Sum(x => x.TotalRevenue);
        var top5Share = Model.Sum(x => x.RevenueSharePercentage);

        <div class="flex items-center justify-between mt-5 pt-3 border-t border-surface-container/50">
            <span class="font-label-caps text-label-caps text-outline">
                İlk 5 Ürün Ciro Payı: <strong class="text-on-surface font-semibold">%@top5Share.ToString("F1", tr)</strong>
            </span>
            <span class="font-data-table text-[12px] font-semibold text-primary">
                ₺@top5Total.ToString("N0", tr)
            </span>
        </div>
    }
</div>