@using SalesPulse.Core.DTOs.SalesIntelligenceDtos
@using System.Globalization
@model SalesIntelligenceKpiDto

@{
    var tr = new CultureInfo("tr-TR");
    var inv = CultureInfo.InvariantCulture;
}

<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-lg mb-10">
    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
            <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Tekrar Alışveriş Oranı</span>
            <div class="w-9 h-9 rounded-xl bg-[#E6FFFB] flex items-center justify-center text-[#08979C]">
                <span class="material-symbols-outlined text-[20px]">repeat</span>
            </div>
        </div>
        <div class="my-3">
            <div class="font-data-metric text-data-metric text-on-surface tracking-tight font-semibold">
                %@Model.RepeatPurchaseRate.ToString("F1", tr)
            </div>
        </div>
        <div class="pt-2">
            <div class="h-1.5 w-full bg-surface-container-low rounded-full overflow-hidden">
                <div class="h-full bg-[#13C2C2] rounded-full" style="width: @Math.Min(Model.RepeatPurchaseRate, 100).ToString("F1", inv)%"></div>
            </div>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
            <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Müşteri Yaşam Boyu Değeri (LTV)</span>
            <div class="w-9 h-9 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[20px]">account_balance_wallet</span>
            </div>
        </div>
        <div class="my-3">
            <div class="font-data-metric text-data-metric text-on-surface tracking-tight font-semibold">
                ₺@Model.CustomerLifetimeValue.ToString("N2", tr)
            </div>
        </div>
        <div class="pt-2">
            <div class="h-1.5 w-full bg-surface-container-low rounded-full overflow-hidden">
                <div class="h-full bg-primary-container rounded-full" style="width: 70%"></div>
            </div>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
            <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Ortalama Sepet Tutarı</span>
            <div class="w-9 h-9 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary">
                <span class="material-symbols-outlined text-[20px]">shopping_basket</span>
            </div>
        </div>
        <div class="my-3">
            <div class="font-data-metric text-data-metric text-on-surface tracking-tight font-semibold">
                ₺@Model.AverageOrderValue.ToString("N2", tr)
            </div>
        </div>
        <div class="pt-2">
            <div class="h-1.5 w-full bg-surface-container-low rounded-full overflow-hidden">
                <div class="h-full bg-secondary-container rounded-full" style="width: 65%"></div>
            </div>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
            <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Ortalama Sipariş Döngüsü</span>
            <div class="w-9 h-9 rounded-xl bg-tertiary-fixed flex items-center justify-center text-tertiary">
                <span class="material-symbols-outlined text-[20px]">timelapse</span>
            </div>
        </div>
        <div class="my-3">
            <div class="font-data-metric text-data-metric text-on-surface tracking-tight font-semibold">
                @Model.AverageOrderCycleDays <span class="text-body-md text-outline font-normal">Gün</span>
            </div>
        </div>
        <div class="pt-2">
            <div class="h-1.5 w-full bg-surface-container-low rounded-full overflow-hidden">
                <div class="h-full bg-tertiary rounded-full" style="width: 80%"></div>
            </div>
        </div>
    </div>
</section>