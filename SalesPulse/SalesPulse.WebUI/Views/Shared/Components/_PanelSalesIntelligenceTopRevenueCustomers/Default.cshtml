@using SalesPulse.Core.DTOs.Common
@using SalesPulse.Core.DTOs.SalesIntelligenceDtos
@model PagedResult<SalesIntelligenceTopRevenueCustomerDto>

@{
    var startItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    var tr = new System.Globalization.CultureInfo("tr-TR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string BuildPageUrl(int targetPage, int? targetPageSize = null)
    {
        var query = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var key in Context.Request.Query.Keys)
        {
            if (!string.IsNullOrWhiteSpace(key))
            {
                query[key] = Context.Request.Query[key].ToString();
            }
        }

        query["page"] = targetPage.ToString();
        query["pageSize"] = (targetPageSize ?? Model.PageSize).ToString();

        return "?" + string.Join("&", query
            .Where(x => !string.IsNullOrEmpty(x.Value))
            .Select(x => $"{System.Net.WebUtility.UrlEncode(x.Key)}={System.Net.WebUtility.UrlEncode(x.Value)}"));
    }
}

<section class="bg-surface-container-lowest rounded-2xl shadow-sm p-space-lg mb-10">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6">
        <div class="flex flex-col">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                <h2 class="font-title-sm text-title-sm text-on-surface">En Yüksek Ciro Sağlayan Müşteriler</h2>
            </div>
        </div>
        <div class="flex items-center gap-space-sm">
            <div class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-lg">
                <span class="font-body-sm text-body-sm text-outline">Görünüm:</span>
                <span class="font-body-sm text-body-sm font-semibold text-on-surface">@Model.Items.Count() / @Model.TotalCount</span>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant">
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase rounded-l-lg">Sıra</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase">Müşteri / Kurum Adı</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase">Bölge &amp; Şehir</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase text-center">Sipariş Adedi</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase text-right">Ort. Sepet (AOV)</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase text-right">Toplam Katkı (Ciro)</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase">Ciro Payı Oranı</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase">Son Satın Alma</th>
                    <th class="py-3 px-4 font-label-caps text-label-caps uppercase text-right rounded-r-lg">Segment Seviyesi</th>
                </tr>
            </thead>
            <tbody class="divide-y-0 text-on-surface">
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var nameParts = item.CustomerName?.Split(' ', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
                        var initials = nameParts.Length >= 2
                            ? $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[1][0])}"
                            : (item.CustomerName?.Length >= 2 ? item.CustomerName.Substring(0, 2).ToUpper() : "VIP");

                        <tr class="hover:bg-primary-fixed/20 transition-colors">
                            <td class="py-3.5 px-4 font-data-table text-data-table">
                                @if (item.Rank == 1)
                                {
                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#FFE58F] text-[#874D00] font-bold text-xs shadow-xs">1</span>
                                }
                                else if (item.Rank == 2)
                                {
                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#E6E8EA] text-[#475569] font-bold text-xs shadow-xs">2</span>
                                }
                                else if (item.Rank == 3)
                                {
                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#FFD591] text-[#873800] font-bold text-xs shadow-xs">3</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-surface-container-low text-outline font-semibold text-xs">@item.Rank</span>
                                }
                            </td>

                            <td class="py-3.5 px-4 font-body-sm text-body-sm font-semibold text-on-surface">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary font-bold text-xs">
                                        @initials
                                    </div>
                                    <div>
                                        <div>@item.CustomerName</div>
                                        <span class="font-data-table text-[11px] text-outline font-normal">Müşteri No: #@item.CustomerId</span>
                                    </div>
                                </div>
                            </td>

                            <td class="py-3.5 px-4 font-body-sm text-body-sm text-on-surface-variant">
                                @item.CityName
                            </td>

                            <td class="py-3.5 px-4 font-data-table text-data-table text-center font-semibold">
                                @item.OrderCount.ToString("N0", tr)
                            </td>

                            <td class="py-3.5 px-4 font-data-table text-data-table text-right font-medium">
                                ₺@item.AverageOrderValue.ToString("N2", tr)
                            </td>

                            <td class="py-3.5 px-4 font-data-table text-data-table text-right font-bold text-primary">
                                ₺@item.TotalRevenue.ToString("N2", tr)
                            </td>

                            <td class="py-3.5 px-4">
                                <div class="w-28">
                                    <div class="flex justify-between font-data-table text-[11px] text-outline mb-1 font-medium">
                                        <span>%@item.RevenueSharePercentage.ToString("F2", tr)</span>
                                    </div>
                                    <div class="h-1.5 w-full bg-surface-container rounded-full overflow-hidden">
                                        <div class="h-full bg-primary rounded-full"
                                             style="width: @Math.Min(item.RevenueSharePercentage, 100).ToString("F1", inv)%"></div>
                                    </div>
                                </div>
                            </td>

                            <td class="py-3.5 px-4 font-data-table text-data-table text-on-surface-variant text-xs">
                                @if (item.LastOrderDate.Date == DateTime.Today)
                                {
                                    <span>Bugün, @item.LastOrderDate.ToString("HH:mm")</span>
                                }
                                else if (item.LastOrderDate.Date == DateTime.Today.AddDays(-1))
                                {
                                    <span>Dün, @item.LastOrderDate.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span>@item.LastOrderDate.ToString("dd MMMM yyyy", tr)</span>
                                }
                            </td>

                            <td class="py-3.5 px-4 text-right">
                                @if (item.SegmentLevel.Contains("Platinum", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#F9F0FF] text-[#531DAB] font-label-caps text-[11px] uppercase font-bold shadow-2xs">
                                        <span class="material-symbols-outlined text-[13px]">diamond</span> Platinum VIP
                                    </span>
                                }
                                else if (item.SegmentLevel.Contains("Gold", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#FFF2E8] text-[#D4380D] font-label-caps text-[11px] uppercase font-bold shadow-2xs">
                                        <span class="material-symbols-outlined text-[13px]">military_tech</span> Gold Üye
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#E6F4FF] text-[#0958D9] font-label-caps text-[11px] uppercase font-bold shadow-2xs">
                                        <span class="material-symbols-outlined text-[13px]">workspace_premium</span> Silver Üye
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="py-8 text-center text-outline font-body-sm">
                            Seçilen kriterlere uygun müşteri verisi bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex items-center justify-between pt-4 mt-2">
        <div class="flex items-center gap-2">
            @if (Model.Page > 1)
            {
                <a href="@BuildPageUrl(Model.Page - 1)" class="p-1.5 rounded-lg bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors shadow-xs flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
            }
            else
            {
                <button class="p-1.5 rounded-lg bg-surface-container-lowest text-outline shadow-xs opacity-40 cursor-not-allowed flex items-center justify-center" disabled>
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </button>
            }

            @if (Model.Page == 1)
            {
                <span class="w-8 h-8 rounded-lg font-data-table text-body-sm font-semibold bg-primary-container text-on-primary shadow-xs flex items-center justify-center">1</span>
            }
            else
            {
                <a href="@BuildPageUrl(1)" class="w-8 h-8 rounded-lg font-data-table text-body-sm text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center">1</a>
            }

            @if (Model.Page > 3)
            {
                <span class="px-1 text-outline font-data-table">...</span>
            }

            @for (int p = Math.Max(2, Model.Page - 1); p <= Math.Min(Model.TotalPages - 1, Model.Page + 1); p++)
            {
                if (p == Model.Page)
                {
                    <span class="w-8 h-8 rounded-lg font-data-table text-body-sm font-semibold bg-primary-container text-on-primary shadow-xs flex items-center justify-center">@p</span>
                }
                else
                {
                    <a href="@BuildPageUrl(p)" class="w-8 h-8 rounded-lg font-data-table text-body-sm text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center">@p</a>
                }
            }

            @if (Model.Page < Model.TotalPages - 2)
            {
                <span class="px-1 text-outline font-data-table">...</span>
            }

            @if (Model.TotalPages > 1)
            {
                if (Model.Page == Model.TotalPages)
                {
                    <span class="px-2 h-8 rounded-lg font-data-table text-body-sm font-semibold bg-primary-container text-on-primary shadow-xs flex items-center justify-center">@Model.TotalPages.ToString("N0")</span>
                }
                else
                {
                    <a href="@BuildPageUrl(Model.TotalPages)" class="px-2 h-8 rounded-lg font-data-table text-body-sm text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center">@Model.TotalPages.ToString("N0")</a>
                }
            }

            @if (Model.Page < Model.TotalPages)
            {
                <a href="@BuildPageUrl(Model.Page + 1)" class="p-1.5 rounded-lg bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors shadow-xs flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            }
            else
            {
                <button class="p-1.5 rounded-lg bg-surface-container-lowest text-outline shadow-xs opacity-40 cursor-not-allowed flex items-center justify-center" disabled>
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </button>
            }
        </div>
    </div>
</section>
