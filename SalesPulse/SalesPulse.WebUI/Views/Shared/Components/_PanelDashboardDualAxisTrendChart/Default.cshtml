@model SalesPulse.Core.DTOs.DashboardDtos.DashboardMonthlySalesTrendDto

@functions {
    string FormatCurrency(decimal amount)
    {
        var tr = new System.Globalization.CultureInfo("tr-TR");
        if (amount >= 1_000_000_000m)
            return $"₺{(amount / 1_000_000_000m).ToString("0.00", tr)} Mr";
        if (amount >= 1_000_000m)
            return $"₺{(amount / 1_000_000m).ToString("0.00", tr)}M";
        if (amount >= 1_000m)
            return $"₺{(amount / 1_000m).ToString("0.0", tr)}K";
        return $"₺{amount.ToString("N0", tr)}";
    }
}

@{
    var tr = new System.Globalization.CultureInfo("tr-TR");

    var peakItem = Model?.MonthlyItems?.OrderByDescending(x => x.TotalRevenue).FirstOrDefault();
    var peakMonthName = !string.IsNullOrEmpty(Model?.PeakMonth) ? Model.PeakMonth : (peakItem?.MonthName ?? "-");
    var peakRevenue = Model?.PeakRevenue > 0 ? Model.PeakRevenue : (peakItem?.TotalRevenue ?? 0m);
}

<div class="xl:col-span-8 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-space-md gap-space-sm">
        <div>
            <span class="font-label-caps text-label-caps uppercase text-on-surface-variant text-xs font-semibold tracking-wider text-slate-400">Performans Eğilimi</span>
            <h2 class="font-title-sm text-title-sm text-on-surface text-lg font-bold text-slate-800">Aylık Satış Eğilimi &amp; Sipariş Hacmi</h2>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-orange-50 border border-orange-200/60 text-orange-700 text-xs font-medium w-fit">
            <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
            <span>Zirve: <strong>@peakMonthName (@FormatCurrency(peakRevenue))</strong></span>
        </div>
    </div>

    <div class="relative w-full min-h-[300px]">
        <div id="monthlySalesTrendChart" class="w-full h-full"></div>
    </div>

    <div class="mt-space-md pt-space-sm bg-surface-container-low rounded-lg p-space-md grid grid-cols-3 gap-2 text-center bg-slate-50/70 border border-slate-100 p-3">
        <div>
            <span class="font-label-caps text-label-caps uppercase text-outline text-[11px] text-slate-400 font-semibold block">En Yüksek Ay</span>
            <p class="font-data-table text-body-sm font-semibold text-slate-800 mt-0.5">
                @peakMonthName (@FormatCurrency(peakRevenue))
            </p>
        </div>
        <div class="border-x border-slate-200/60">
            <span class="font-label-caps text-label-caps uppercase text-outline text-[11px] text-slate-400 font-semibold block">Aylık Ort. Ciro</span>
            <p class="font-data-table text-body-sm font-semibold text-slate-800 mt-0.5">
                ₺@FormatCurrency(Model.AverageMonthlyRevenue)
            </p>
        </div>
        <div>
            <span class="font-label-caps text-label-caps uppercase text-outline text-[11px] text-slate-400 font-semibold block">Hedef Tutma Oranı</span>
            <p class="font-data-table text-body-sm font-semibold @(Model.TargetAchievementRate >= 100 ? "text-emerald-600" : "text-amber-600") mt-0.5">
                %@Model.TargetAchievementRate.ToString("0.0", tr) Başarı
            </p>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyItems));

        if (!rawData || rawData.length === 0) return;

        const categories = rawData.map(x => x.MonthName);
        const revenues = rawData.map(x => x.TotalRevenue); 
        const orders = rawData.map(x => x.TotalOrderCount);

        const options = {
            series: [
                {
                    name: 'Ciro (₺)',
                    type: 'area',
                    data: revenues
                },
                {
                    name: 'Sipariş Hacmi',
                    type: 'line',
                    data: orders
                }
            ],
            chart: {
                height: 300,
                type: 'line',
                toolbar: { show: false },
                zoom: { enabled: false },
                fontFamily: 'inherit'
            },
            colors: ['#ff7a45', '#005eb2'],
            fill: {
                type: ['gradient', 'solid'],
                gradient: {
                    shade: 'light',
                    type: 'vertical',
                    shadeIntensity: 0.5,
                    gradientToColors: ['#ffffff'],
                    inverseColors: false,
                    opacityFrom: 0.35,
                    opacityTo: 0.02,
                    stops: [0, 90, 100]
                }
            },
            stroke: {
                curve: 'smooth',
                width: [3, 2.5],
                dashArray: [0, 5]
            },
            markers: {
                size: [4, 3],
                strokeColors: '#ffffff',
                strokeWidth: 2,
                hover: { size: 6 }
            },
            xaxis: {
                categories: categories,
                axisBorder: { show: false },
                axisTicks: { show: false },
                labels: {
                    style: { colors: '#94a3b8', fontSize: '12px' }
                }
            },
            yaxis: [
                {
                    labels: {
                        formatter: function (val) {
                            if (val >= 1000000000) {
                                return `₺${(val / 1000000000).toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 1 })} Mr`;
                            }
                            if (val >= 1000000) {
                                return `₺${Math.round(val / 1000000)}M`;
                            }
                            return `₺${val}`;
                        },
                        style: { colors: '#94a3b8', fontSize: '11px' }
                    }
                },
                {
                    opposite: true,
                    labels: {
                        formatter: val => `${Math.round(val / 1000)}K`,
                        style: { colors: '#94a3b8', fontSize: '11px' }
                    }
                }
            ],
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 4
            },
            tooltip: {
                shared: true,
                intersect: false,
                y: {
                    formatter: function (y, { seriesIndex }) {
                        if (typeof y !== "undefined") {
                            if (seriesIndex === 0) {
                                const billionFormatted = (y / 1000000000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                const exactFormatted = Math.round(y).toLocaleString('tr-TR');
                                return `₺${billionFormatted} Mr (₺${exactFormatted})`;
                            }
                            return `${Math.round(y).toLocaleString('tr-TR')} adet`;
                        }
                        return y;
                    }
                }
            },
            legend: {
                position: 'top',
                horizontalAlign: 'right'
            }
        };

        const chart = new ApexCharts(document.querySelector("#monthlySalesTrendChart"), options);
        chart.render();
    });
</script>