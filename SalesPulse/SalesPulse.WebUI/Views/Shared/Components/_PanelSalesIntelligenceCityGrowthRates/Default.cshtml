@using SalesPulse.Core.DTOs.SalesIntelligenceDtos
@using System.Globalization
@model List<TopCitySalesDto>

@{
    var tr = new CultureInfo("tr-TR");

    var barColors = new[]
    {
        "bg-[#872400]", 
        "bg-[#FF7A45]",
        "bg-[#1677FF]",
        "bg-[#722ED1]",
        "bg-[#13C2C2]",
        "bg-[#FA8C16]", 
        "bg-[#1890FF]"
    };

    string FormatRevenue(decimal amount)
    {
        if (amount >= 1_000_000_000)
            return $"₺{(amount / 1_000_000_000m).ToString("F2", tr)} Mr";

        if (amount >= 1_000_000)
            return $"₺{(amount / 1_000_000m).ToString("F2", tr)}M";

        if (amount >= 1_000)
            return $"₺{(amount / 1_000m).ToString("F0", tr)}k";

        return $"₺{amount.ToString("N0", tr)}";
    }

    var mainCities = Model?.Take(6).ToList() ?? new List<TopCitySalesDto>();
    var secondaryCities = Model?.Skip(6).Take(4).ToList() ?? new List<TopCitySalesDto>();
}

<div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
    <div>
        <div class="flex items-center justify-between mb-1">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FF7A45] shrink-0"></span>
                <h2 class="font-title-sm text-title-sm text-on-surface">En Çok Satış Yapılan Şehirler</h2>
            </div>
            <span class="font-label-caps text-label-caps px-2 py-0.5 rounded bg-[#E6F4FF] text-[#1677FF] uppercase font-semibold">
                Bölgesel Ciro
            </span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-5">
            Türkiye genelinde en yüksek hacme sahip 10 şehrin yıllık büyüme ve ciro dağılımı.
        </p>

        <div class="flex flex-col gap-4">
            @if (mainCities.Any())
            {
                for (int i = 0; i < mainCities.Count; i++)
                {
                    var city = mainCities[i];
                    var barColor = barColors[i % barColors.Length];
                    var isPositive = city.GrowthRate >= 0;

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <div class="flex items-center gap-2">
                                <span class="font-body-sm text-body-sm font-bold text-on-surface">@city.CityName</span>
                                <span class="font-data-table text-xs text-outline font-medium">@FormatRevenue(city.TotalRevenue)</span>
                            </div>
                            <span class="font-label-caps text-xs font-bold @(isPositive ? "text-[#D4380D]" : "text-error") flex items-center">
                                @(isPositive ? "+" : "")%@city.GrowthRate.ToString("F1", tr)
                            </span>
                        </div>

                        <div class="w-full bg-surface-container-low h-2 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-500 @barColor" 
                                 style="width: @city.PercentageOfMax.ToString(CultureInfo.InvariantCulture)%">
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-8 text-center text-outline font-body-sm">
                    Döneme ait bölgesel satış verisi bulunamadı.
                </div>
            }
        </div>
    </div>

    @if (secondaryCities.Any())
    {
        <div class="grid grid-cols-2 gap-3 mt-6 pt-4 border-t border-surface-container/50">
            @foreach (var city in secondaryCities)
            {
                var isPositive = city.GrowthRate >= 0;
                <div class="bg-surface-container-low/50 p-2.5 rounded-xl border border-outline/5 flex flex-col justify-between">
                    <span class="font-body-sm text-xs font-semibold text-outline truncate" title="@city.CityName">
                        @city.CityName
                    </span>
                    <div class="flex items-baseline justify-between mt-1">
                        <span class="font-label-caps text-xs font-bold @(isPositive ? "text-primary" : "text-error")">
                            @(isPositive ? "+" : "")%@city.GrowthRate.ToString("F1", tr)
                        </span>
                        <span class="font-data-table text-[11px] text-on-surface-variant font-medium">
                            (@FormatRevenue(city.TotalRevenue))
                        </span>
                    </div>
                </div>
            }
        </div>
    }
</div>