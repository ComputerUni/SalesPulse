@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}


<div class="flex flex-col w-full pb-16">
    <!-- Top Ambient Glow (Subtle warm radiance) -->
    <div class="relative w-full">
        <div class="absolute -top-10 left-1/4 w-96 h-48 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-4 right-10 w-80 h-40 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
    </div>
    <!-- Section 1: Executive Overview Header & Ribbon -->
    <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-space-lg mb-space-xl mt-5">
        <div class="flex flex-col gap-1">
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Genel Performans Özeti</h1>
        </div>
    </div>
    <!-- Section 2: 4 Primary Strategic KPI Cards -->
    @await Component.InvokeAsync("_PanelDashboardKpiCards")
    <!-- Section 3: Visualizations Row 1 (Sales Trend & Order Status Distribution) -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-gutter mb-space-xl">
        <!-- Dual-Axis Trend Chart (65% -> 8 cols on xl) -->
        <div class="xl:col-span-8 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-space-md gap-space-sm">
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Performans Eğilimi</span>
                    <h2 class="font-title-sm text-title-sm text-on-surface">Aylık Satış Eğilimi &amp; Sipariş Hacmi</h2>
                </div>
                <!-- Interactive Chart Legend -->
                <div class="flex items-center gap-space-md">
                    <div class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded-full bg-primary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Ciro (₺ Milyon)</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-3 h-1.5 rounded-full bg-secondary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Sipariş (Bin Adet)</span>
                    </div>
                </div>
            </div>
            <!-- High Fidelity Dual-Axis SVG Area Chart -->
            <div class="relative w-full h-72 pt-space-sm">
                <svg class="w-full h-full overflow-visible" preserveaspectratio="none" viewbox="0 0 800 240">
                    <defs>
                        <lineargradient id="primaryAreaGrad" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="#ff7a45" stop-opacity="0.28"></stop>
                            <stop offset="60%" stop-color="#ff7a45" stop-opacity="0.08"></stop>
                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0"></stop>
                        </lineargradient>
                        <lineargradient id="lineGradPrimary" x1="0" x2="1" y1="0" y2="0">
                            <stop offset="0%" stop-color="#a73a05"></stop>
                            <stop offset="100%" stop-color="#ff7a45"></stop>
                        </lineargradient>
                    </defs>
                    <!-- Horizontal Soft Grid Guides -->
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="40" y2="40"></line>
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="90" y2="90"></line>
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="140" y2="140"></line>
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="190" y2="190"></line>
                    <!-- Revenue Area Gradient Fill -->
                    <path d="M 0 170
                    C 66 160, 133 130, 200 135
                    C 266 140, 333 105, 400 95
                    C 466 85, 533 115, 600 75
                    C 666 45, 733 35, 800 22
                    L 800 210 L 0 210 Z" fill="url(#primaryAreaGrad)"></path>
                    <!-- Revenue Line Stroke -->
                    <path d="M 0 170
                    C 66 160, 133 130, 200 135
                    C 266 140, 333 105, 400 95
                    C 466 85, 533 115, 600 75
                    C 666 45, 733 35, 800 22" fill="none" stroke="url(#lineGradPrimary)" stroke-linecap="round" stroke-width="3"></path>
                    <!-- Order Volume Dashed Line Stroke -->
                    <path d="M 0 185
                    C 66 175, 133 150, 200 152
                    C 266 155, 333 125, 400 115
                    C 466 105, 533 128, 600 92
                    C 666 70, 733 60, 800 48" fill="none" stroke="#4297ff" stroke-dasharray="5 5" stroke-linecap="round" stroke-width="2.5"></path>
                    <!-- Data Points Highlight on Peak Months -->
                    <circle cx="400" cy="95" fill="#ff7a45" r="4.5" stroke="#ffffff" stroke-width="2.5"></circle>
                    <circle cx="600" cy="75" fill="#ff7a45" r="4.5" stroke="#ffffff" stroke-width="2.5"></circle>
                    <circle cx="800" cy="22" fill="#a73a05" r="5" stroke="#ffffff" stroke-width="3"></circle>
                </svg>
                <!-- Peak Metric Callout Floating Pin -->
                <div class="absolute top-2 right-4 bg-on-surface text-surface-container-lowest px-2.5 py-1 rounded shadow-md pointer-events-none flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                    <span class="font-data-table text-body-sm font-semibold">Kasım Zirvesi: ₺5.42M</span>
                </div>
            </div>
            <!-- X-Axis Months -->
            <div class="grid grid-cols-12 text-center pt-space-xs font-label-caps text-label-caps text-on-surface-variant uppercase">
                <span>Oca</span><span>Şub</span><span>Mar</span><span>Nis</span>
                <span>May</span><span>Haz</span><span>Tem</span><span>Ağu</span>
                <span>Eyl</span><span>Eki</span><span>Kas</span><span>Ara</span>
            </div>
            <!-- Footer Micro-Metrics -->
            <div class="mt-space-md pt-space-sm bg-surface-container-low rounded-lg p-space-md grid grid-cols-3 gap-2 text-center">
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-outline">En Yüksek Ay</span>
                    <p class="font-data-table text-body-sm font-semibold text-on-surface mt-0.5">Aralık (₺5.64M)</p>
                </div>
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-outline">Aylık Ort. Hacim</span>
                    <p class="font-data-table text-body-sm font-semibold text-on-surface mt-0.5">₺4.054.200</p>
                </div>
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-outline">Hedef Tutma Oranı</span>
                    <p class="font-data-table text-body-sm font-semibold text-primary mt-0.5">%106.8 Başarı</p>
                </div>
            </div>
        </div>
        <!-- Status Distribution & Fulfillment (35% -> 4 cols on xl) -->
        <div class="xl:col-span-4 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between pb-space-sm">
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Operasyonel Dağılım</span>
                    <h2 class="font-title-sm text-title-sm text-on-surface">Sipariş Durumları &amp; Dönüşüm</h2>
                </div>
                <span class="material-symbols-outlined text-outline text-[20px]">pie_chart</span>
            </div>
            <!-- Visual Donut Chart Simulation (Inline Clean SVG) -->
            <div class="relative flex items-center justify-center py-space-sm">
                <svg class="w-44 h-44 -rotate-90" viewbox="0 0 100 100">
                    <!-- Background ring -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#f0f3ff" stroke-width="14"></circle>
                    <!-- Tamamlanan: 74.2% -> 238.8 circ -> 177 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#005eb2" stroke-dasharray="177 238.8" stroke-dashoffset="0" stroke-width="14"></circle>
                    <!-- Kargoda: 18.5% -> 44.1 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#ff7a45" stroke-dasharray="44.1 238.8" stroke-dashoffset="-177" stroke-width="14"></circle>
                    <!-- İşlemde: 5.1% -> 12.1 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#4297ff" stroke-dasharray="12.1 238.8" stroke-dashoffset="-221.1" stroke-width="14"></circle>
                    <!-- İptal: 2.2% -> 5.2 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#7a3ac5" stroke-dasharray="5.5 238.8" stroke-dashoffset="-233.2" stroke-width="14"></circle>
                </svg>
                <!-- Donut Center Aggregate -->
                <div class="absolute flex flex-col items-center justify-center text-center">
                    <span class="font-display-lg text-data-metric text-on-surface tracking-tight">342.1K</span>
                    <span class="font-label-caps text-label-caps text-outline uppercase">Toplam İşlem</span>
                </div>
            </div>
            <!-- Breakdown Metric List -->
            <div class="flex flex-col gap-2 pt-space-xs">
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">Teslim Edilen</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">253.897 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-secondary">%74.2</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">Kargoda / Sevk</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">63.303 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-primary">%18.5</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">Hazırlanan / İşlemde</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">17.451 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-secondary-container">%5.1</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-tertiary"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">İade &amp; İptal Oranı</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">7.528 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-tertiary">%2.2</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-space-xl">

        @await Component.InvokeAsync("_PanelDashboardCategoryPerformance")

        @await Component.InvokeAsync("_PanelDashboardRegionalDistribution")

    </div>

    <div id="top-selling-container">
        @await Component.InvokeAsync("_PanelDashboardTopSellingProducts")
    </div>

</div>

