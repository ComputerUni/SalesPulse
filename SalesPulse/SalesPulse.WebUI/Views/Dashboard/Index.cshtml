@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="flex flex-col w-full pb-2">
    <!-- Top Ambient Glow (Subtle warm radiance) -->
    <div class="relative w-full">
        <div class="absolute -top-10 left-1/4 w-96 h-48 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-4 right-10 w-80 h-40 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
    </div>
    <!-- Section 1: Executive Overview Header & Ribbon -->
    <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-space-lg mb-space-xl mt-5">
        <div class="flex flex-col gap-1">
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Genel Performans Özeti</h1>
        </div>
        <!-- Filter Ribbon Toolbar -->
        <div class="bg-surface-container-lowest shadow-sm rounded-xl p-space-xs flex flex-wrap items-center gap-space-xs">
            <div class="flex items-center gap-1 px-space-sm py-1.5 rounded-lg bg-surface-container-low text-on-surface">
                <span class="material-symbols-outlined text-[18px] text-outline">date_range</span>
                <select class="bg-transparent font-body-sm text-body-sm font-semibold text-on-surface focus:outline-none cursor-pointer pr-1">
                    <option selected="">Son 12 Ay (2023 - 2024)</option>
                    <option>Yılbaşından Bugüne (YTD)</option>
                    <option>Bu Çeyrek (Q3)</option>
                    <option>Son 30 Gün</option>
                </select>
            </div>
            <div class="h-6 w-px bg-surface-container-high mx-1"></div>
            <button class="px-space-md py-1.5 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold shadow-sm hover:opacity-95 transition-all flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">tune</span>
                Uygula
            </button>
            <button class="px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low font-body-sm text-body-sm transition-all" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
            </button>
        </div>
    </div>
</div>

@await Component.InvokeAsync("_PanelDashboardKpiCards")

<div class="grid grid-cols-1 xl:grid-cols-12 gap-gutter mb-space-xl">

    @await Component.InvokeAsync("_PanelDashboardDualAxisTrendChart")

    @await Component.InvokeAsync("_PanelDashboardVisualDonutChart")

</div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-space-xl">

    @await Component.InvokeAsync("_PanelDashboardCategoryPerformance")

    @await Component.InvokeAsync("_PanelDashboardRegionalDistribution")

</div>

<div id="top-selling-container">

    @await Component.InvokeAsync("_PanelDashboardTopSellingProducts")

</div>

