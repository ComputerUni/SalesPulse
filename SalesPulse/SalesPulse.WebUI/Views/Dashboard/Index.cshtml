@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}


<div class="flex flex-col w-full pb-16">
    <!-- Top Ambient Glow (Subtle warm radiance) -->
    <div class="relative w-full">
        <div class="absolute -top-10 left-1/4 w-96 h-48 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-4 right-10 w-80 h-40 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
    </div>
    <!-- Section 1: Executive Overview Header & Ribbon -->
    <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-space-lg mb-space-xl">
        <div class="flex flex-col gap-1">
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Genel Performans Özeti</h1>
        </div>
        <!-- Filter Ribbon Toolbar -->
        <div class="bg-surface-container-lowest shadow-sm rounded-xl p-space-xs flex flex-wrap items-center gap-space-xs">
            <div class="flex items-center gap-1 px-space-sm py-1.5 rounded-lg bg-surface-container-low text-on-surface">
                <span class="material-symbols-outlined text-[18px] text-outline">date_range</span>
                <select class="bg-transparent font-body-sm text-body-sm font-semibold text-on-surface focus:outline-none cursor-pointer pr-1">
                    <option selected="">Son 12 Ay (2023 - 2024)</option>
                    <option>Yılbaşından Bugüne (YTD)</option>
                    <option>Bu Çeyrek (Q3)</option>
                    <option>Son 30 Gün</option>
                </select>
            </div>
            <div class="flex items-center gap-1 px-space-sm py-1.5 rounded-lg bg-surface-container-low text-on-surface">
                <span class="material-symbols-outlined text-[18px] text-outline">hub</span>
                <select class="bg-transparent font-body-sm text-body-sm text-on-surface focus:outline-none cursor-pointer pr-1">
                    <option selected="">Tüm Satış Kanalları</option>
                    <option>Web Platformu</option>
                    <option>Mobil Uygulama (iOS/Android)</option>
                    <option>Pazaryerleri (Marketplace)</option>
                    <option>Kurumsal B2B Portal</option>
                </select>
            </div>
            <div class="flex items-center gap-1 px-space-sm py-1.5 rounded-lg bg-surface-container-low text-on-surface">
                <span class="material-symbols-outlined text-[18px] text-outline">location_on</span>
                <select class="bg-transparent font-body-sm text-body-sm text-on-surface focus:outline-none cursor-pointer pr-1">
                    <option selected="">Tüm Şehirler (Türkiye)</option>
                    <option>Marmara Bölgesi</option>
                    <option>İç Anadolu</option>
                    <option>Ege &amp; Akdeniz</option>
                </select>
            </div>
            <div class="h-6 w-px bg-surface-container-high mx-1"></div>
            <button class="px-space-md py-1.5 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold shadow-sm hover:opacity-95 transition-all flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">tune</span>
                Uygula
            </button>
            <button class="px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low font-body-sm text-body-sm transition-all" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
            </button>
        </div>
    </div>
    <!-- Section 2: 4 Primary Strategic KPI Cards -->
    @await Component.InvokeAsync("_PanelDashboardKpiCards")
    <!-- Section 3: Visualizations Row 1 (Sales Trend & Order Status Distribution) -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-gutter mb-space-xl">
        <!-- Dual-Axis Trend Chart (65% -> 8 cols on xl) -->
        <div class="xl:col-span-8 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-space-md gap-space-sm">
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Performans Eğilimi</span>
                    <h2 class="font-title-sm text-title-sm text-on-surface">Aylık Satış Eğilimi &amp; Sipariş Hacmi</h2>
                </div>
                <!-- Interactive Chart Legend -->
                <div class="flex items-center gap-space-md">
                    <div class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded-full bg-primary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Ciro (₺ Milyon)</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-3 h-1.5 rounded-full bg-secondary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Sipariş (Bin Adet)</span>
                    </div>
                </div>
            </div>
            <!-- High Fidelity Dual-Axis SVG Area Chart -->
            <div class="relative w-full h-72 pt-space-sm">
                <svg class="w-full h-full overflow-visible" preserveaspectratio="none" viewbox="0 0 800 240">
                    <defs>
                        <lineargradient id="primaryAreaGrad" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="#ff7a45" stop-opacity="0.28"></stop>
                            <stop offset="60%" stop-color="#ff7a45" stop-opacity="0.08"></stop>
                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0"></stop>
                        </lineargradient>
                        <lineargradient id="lineGradPrimary" x1="0" x2="1" y1="0" y2="0">
                            <stop offset="0%" stop-color="#a73a05"></stop>
                            <stop offset="100%" stop-color="#ff7a45"></stop>
                        </lineargradient>
                    </defs>
                    <!-- Horizontal Soft Grid Guides -->
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="40" y2="40"></line>
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="90" y2="90"></line>
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="140" y2="140"></line>
                    <line stroke="#f0f3ff" stroke-dasharray="4 4" stroke-width="1.2" x1="0" x2="800" y1="190" y2="190"></line>
                    <!-- Revenue Area Gradient Fill -->
                    <path d="M 0 170
                    C 66 160, 133 130, 200 135
                    C 266 140, 333 105, 400 95
                    C 466 85, 533 115, 600 75
                    C 666 45, 733 35, 800 22
                    L 800 210 L 0 210 Z" fill="url(#primaryAreaGrad)"></path>
                    <!-- Revenue Line Stroke -->
                    <path d="M 0 170
                    C 66 160, 133 130, 200 135
                    C 266 140, 333 105, 400 95
                    C 466 85, 533 115, 600 75
                    C 666 45, 733 35, 800 22" fill="none" stroke="url(#lineGradPrimary)" stroke-linecap="round" stroke-width="3"></path>
                    <!-- Order Volume Dashed Line Stroke -->
                    <path d="M 0 185
                    C 66 175, 133 150, 200 152
                    C 266 155, 333 125, 400 115
                    C 466 105, 533 128, 600 92
                    C 666 70, 733 60, 800 48" fill="none" stroke="#4297ff" stroke-dasharray="5 5" stroke-linecap="round" stroke-width="2.5"></path>
                    <!-- Data Points Highlight on Peak Months -->
                    <circle cx="400" cy="95" fill="#ff7a45" r="4.5" stroke="#ffffff" stroke-width="2.5"></circle>
                    <circle cx="600" cy="75" fill="#ff7a45" r="4.5" stroke="#ffffff" stroke-width="2.5"></circle>
                    <circle cx="800" cy="22" fill="#a73a05" r="5" stroke="#ffffff" stroke-width="3"></circle>
                </svg>
                <!-- Peak Metric Callout Floating Pin -->
                <div class="absolute top-2 right-4 bg-on-surface text-surface-container-lowest px-2.5 py-1 rounded shadow-md pointer-events-none flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                    <span class="font-data-table text-body-sm font-semibold">Kasım Zirvesi: ₺5.42M</span>
                </div>
            </div>
            <!-- X-Axis Months -->
            <div class="grid grid-cols-12 text-center pt-space-xs font-label-caps text-label-caps text-on-surface-variant uppercase">
                <span>Oca</span><span>Şub</span><span>Mar</span><span>Nis</span>
                <span>May</span><span>Haz</span><span>Tem</span><span>Ağu</span>
                <span>Eyl</span><span>Eki</span><span>Kas</span><span>Ara</span>
            </div>
            <!-- Footer Micro-Metrics -->
            <div class="mt-space-md pt-space-sm bg-surface-container-low rounded-lg p-space-md grid grid-cols-3 gap-2 text-center">
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-outline">En Yüksek Ay</span>
                    <p class="font-data-table text-body-sm font-semibold text-on-surface mt-0.5">Aralık (₺5.64M)</p>
                </div>
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-outline">Aylık Ort. Hacim</span>
                    <p class="font-data-table text-body-sm font-semibold text-on-surface mt-0.5">₺4.054.200</p>
                </div>
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-outline">Hedef Tutma Oranı</span>
                    <p class="font-data-table text-body-sm font-semibold text-primary mt-0.5">%106.8 Başarı</p>
                </div>
            </div>
        </div>
        <!-- Status Distribution & Fulfillment (35% -> 4 cols on xl) -->
        <div class="xl:col-span-4 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between pb-space-sm">
                <div>
                    <span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Operasyonel Dağılım</span>
                    <h2 class="font-title-sm text-title-sm text-on-surface">Sipariş Durumları &amp; Dönüşüm</h2>
                </div>
                <span class="material-symbols-outlined text-outline text-[20px]">pie_chart</span>
            </div>
            <!-- Visual Donut Chart Simulation (Inline Clean SVG) -->
            <div class="relative flex items-center justify-center py-space-sm">
                <svg class="w-44 h-44 -rotate-90" viewbox="0 0 100 100">
                    <!-- Background ring -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#f0f3ff" stroke-width="14"></circle>
                    <!-- Tamamlanan: 74.2% -> 238.8 circ -> 177 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#005eb2" stroke-dasharray="177 238.8" stroke-dashoffset="0" stroke-width="14"></circle>
                    <!-- Kargoda: 18.5% -> 44.1 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#ff7a45" stroke-dasharray="44.1 238.8" stroke-dashoffset="-177" stroke-width="14"></circle>
                    <!-- İşlemde: 5.1% -> 12.1 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#4297ff" stroke-dasharray="12.1 238.8" stroke-dashoffset="-221.1" stroke-width="14"></circle>
                    <!-- İptal: 2.2% -> 5.2 stroke -->
                    <circle cx="50" cy="50" fill="none" r="38" stroke="#7a3ac5" stroke-dasharray="5.5 238.8" stroke-dashoffset="-233.2" stroke-width="14"></circle>
                </svg>
                <!-- Donut Center Aggregate -->
                <div class="absolute flex flex-col items-center justify-center text-center">
                    <span class="font-display-lg text-data-metric text-on-surface tracking-tight">342.1K</span>
                    <span class="font-label-caps text-label-caps text-outline uppercase">Toplam İşlem</span>
                </div>
            </div>
            <!-- Breakdown Metric List -->
            <div class="flex flex-col gap-2 pt-space-xs">
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">Teslim Edilen</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">253.897 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-secondary">%74.2</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">Kargoda / Sevk</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">63.303 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-primary">%18.5</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">Hazırlanan / İşlemde</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">17.451 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-secondary-container">%5.1</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low/70">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-tertiary"></span>
                        <span class="font-body-sm text-body-sm text-on-surface font-medium">İade &amp; İptal Oranı</span>
                    </div>
                    <div class="flex items-center gap-space-sm">
                        <span class="font-data-table text-body-sm text-on-surface-variant">7.528 adet</span>
                        <span class="font-data-table text-body-sm font-semibold text-tertiary">%2.2</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-space-xl">

        @await Component.InvokeAsync("_PanelDashboardCategoryPerformance")

        @await Component.InvokeAsync("_PanelDashboardRegionalDistribution")

    </div>
    <!-- Section 5: Top Selling Products (En Çok Satan 10 Ürün) Data Table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
        <!-- Table Header Controls -->
        <div class="p-space-lg flex flex-col sm:flex-row sm:items-center justify-between gap-space-md border-b border-surface-container-low">
            <div>
                <span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Katalog Liderleri</span>
                <h2 class="font-title-sm text-title-sm text-on-surface">En Çok Satan 10 Ürün &amp; Karlılık Sıralaması</h2>
            </div>
            <div class="flex items-center gap-space-sm">
                <!-- Quick Interval Tabs -->
                <div class="flex items-center bg-surface-container-low p-1 rounded-lg">
                    <button class="px-space-md py-1 rounded font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-all">Haftalık</button>
                    <button class="px-space-md py-1 rounded font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-all">Aylık</button>
                    <button class="px-space-md py-1 rounded font-body-sm text-body-sm font-semibold bg-surface-container-lowest text-on-surface shadow-xs transition-all">Yıllık</button>
                </div>
                <button class="flex items-center gap-1 px-space-md py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface font-body-sm text-body-sm transition-all">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    Excel
                </button>
            </div>
        </div>
        <!-- Responsive Table -->
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/60 font-label-caps text-label-caps uppercase text-on-surface-variant">
                        <th class="py-space-md px-space-lg w-16 text-center">Sıra</th>
                        <th class="py-space-md px-space-md min-w-[280px]">Ürün Adı &amp; Model</th>
                        <th class="py-space-md px-space-md">Kategori</th>
                        <th class="py-space-md px-space-md text-right">Satış Adedi</th>
                        <th class="py-space-md px-space-md text-right">Birim Fiyat</th>
                        <th class="py-space-md px-space-md text-right">Toplam Ciro</th>
                        <th class="py-space-md px-space-md text-center">Stok Durumu</th>
                        <th class="py-space-md px-space-lg text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-low font-body-sm text-body-sm">
                    <!-- Product 1 -->
                    <tr class="hover:bg-surface-container-low/40 transition-colors">
                        <td class="py-space-md px-space-lg text-center font-data-table font-bold text-primary">#1</td>
                        <td class="py-space-md px-space-md">
                            <div class="flex items-center gap-space-sm">
                                <img class="w-10 h-10 rounded-lg object-cover bg-surface-container-low shrink-0" data-alt="High quality professional matte black flagship wireless noise-canceling headphones studio shot on white background, sharp contrast warm lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxRmQLCfnmcL2USGCEhIkN8uyglhOLm8sCynAlSyP11eGHoKTHpd1V-xJMPjDEsAHyi_UShXFai6cYbmbOiVx93iIfk3e7O3wc7eOAG0ybkc1mVyFnjs0Dz4AvwJEsXvrjPNqdyn2pHcwsb3QG6AV1dNlns0oRp_YA3xYHwGgnn-M9vA4ko7QbocRJK47A1Ky346XwZZ9fefWxYSdbM1r04ndwKtqYc-1EO8REiO05nnlbYm3gDIhJVQ" />
                                <div class="flex flex-col min-w-0">
                                    <span class="font-medium text-on-surface truncate">Vanguard SoundPro Max Kablosuz Kulaklık</span>
                                    <span class="font-data-table text-[11px] text-outline">SKU: VG-AUD-9921</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-space-md px-space-md">
                            <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-caps text-label-caps">Elektronik</span>
                        </td>
                        <td class="py-space-md px-space-md text-right font-data-table font-semibold text-on-surface">14.820</td>
                        <td class="py-space-md px-space-md text-right font-data-table text-on-surface-variant">₺2.450</td>
                        <td class="py-space-md px-space-md text-right font-data-table font-bold text-on-surface">₺36.309.000</td>
                        <td class="py-space-md px-space-md text-center">
                            <span class="px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps">Stokta (842)</span>
                        </td>
                        <td class="py-space-md px-space-lg text-right">
                            <button class="p-1 rounded hover:bg-surface-container text-on-surface-variant hover:text-on-surface">
                                <span class="material-symbols-outlined text-[18px]">more_vert</span>
                            </button>
                        </td>
                    </tr>
                    <!-- Product 2 -->
                    <tr class="hover:bg-surface-container-low/40 transition-colors">
                        <td class="py-space-md px-space-lg text-center font-data-table font-bold text-primary">#2</td>
                        <td class="py-space-md px-space-md">
                            <div class="flex items-center gap-space-sm">
                                <img class="w-10 h-10 rounded-lg object-cover bg-surface-container-low shrink-0" data-alt="Ergonomic mechanical executive chair in slate grey mesh and polished aluminum base, isolated clean studio product photo" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC8yPfnTtn_c4uxTnmVJJG7n0xxgkOAmK6FP1Jo02tUFo0Zdxs89IvEj9InW4BwFoe2uQFoBWQA6vQOLSWh413NZfwYNxk3XVdlumY0npIAu-pXvZ_JnhfDtHvOS9o0wGuJeCPOpj1-T2b2wQ-j1Usyjrz6aMlDAGKzuh0_NFMhgk2XLIz--0LXA01H0aSPpTjvb_fnYUILc0YrTQWDNGWdv5SRd9lfStdU7qnUqqfeuPBtwIcnGibuOg" />
                                <div class="flex flex-col min-w-0">
                                    <span class="font-medium text-on-surface truncate">ErgoFlex Maestro Çalışma Koltuğu</span>
                                    <span class="font-data-table text-[11px] text-outline">SKU: EF-FUR-4410</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-space-md px-space-md">
                            <span class="px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps">Ev &amp; Ofis</span>
                        </td>
                        <td class="py-space-md px-space-md text-right font-data-table font-semibold text-on-surface">6.140</td>
                        <td class="py-space-md px-space-md text-right font-data-table text-on-surface-variant">₺3.850</td>
                        <td class="py-space-md px-space-md text-right font-data-table font-bold text-on-surface">₺23.639.000</td>
                        <td class="py-space-md px-space-md text-center">
                            <span class="px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps">Stokta (319)</span>
                        </td>
                        <td class="py-space-md px-space-lg text-right">
                            <button class="p-1 rounded hover:bg-surface-container text-on-surface-variant hover:text-on-surface">
                                <span class="material-symbols-outlined text-[18px]">more_vert</span>
                            </button>
                        </td>
                    </tr>
                    <!-- Product 3 -->
                    <tr class="hover:bg-surface-container-low/40 transition-colors">
                        <td class="py-space-md px-space-lg text-center font-data-table font-bold text-primary">#3</td>
                        <td class="py-space-md px-space-md">
                            <div class="flex items-center gap-space-sm">
                                <img class="w-10 h-10 rounded-lg object-cover bg-surface-container-low shrink-0" data-alt="Minimalist automatic coffee espresso machine with chrome accents and brushed steel body, premium kitchen product presentation" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuo5KP_5wIQnsD9RfNi5Pr5KpJbfH2l4rvZK_ZmMIHifNMco2iYuuewaD-DoWwr12xjiPPKwUIIM-U4XQ6BiGA2KrOzPeSSaSmyMJtrp9rkGvGjYx2F_3_EBbbEfnrkd_9y_9gF3og4B5Hvaz86tZwrgPjPA8vsTEIik-iJYnJiLiAPRQSpSDg_m4N6eJw2Fe8nIIWCPWmWGg_INw4r__WHX9oWPOsd_zd6MvUl_gDD1-iW9wOzrdU5g" />
                                <div class="flex flex-col min-w-0">
                                    <span class="font-medium text-on-surface truncate">Barista Touch Akıllı Espresso Makinesi</span>
                                    <span class="font-data-table text-[11px] text-outline">SKU: BR-KIT-7782</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-space-md px-space-md">
                            <span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-caps text-label-caps">Mutfak</span>
