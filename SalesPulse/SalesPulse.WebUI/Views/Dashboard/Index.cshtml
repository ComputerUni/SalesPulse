@using SalesPulse.Core.DTOs.DashboardDtos
@model DashboardFilterDto

@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="flex flex-col w-full pb-2">
    <div class="relative w-full">
        <div class="absolute -top-10 left-1/4 w-96 h-48 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-4 right-10 w-80 h-40 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
    </div>
    <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-space-lg mb-space-xl mt-5">
        <div class="flex flex-col gap-1">
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Genel Performans Özeti</h1>
        </div>
        <form method="get" id="filterForm" class="bg-surface-container-lowest shadow-sm rounded-xl p-space-xs flex flex-wrap items-center gap-space-xs">
            <input type="hidden" name="startDate" id="hiddenStartDate" value="@(Model?.StartDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="endDate" id="hiddenEndDate" value="@(Model?.EndDate?.ToString("yyyy-MM-dd"))" />

            <div class="flex items-center gap-1 px-space-sm py-1.5 rounded-lg bg-surface-container-low text-on-surface">
                <span class="material-symbols-outlined text-[18px] text-outline">date_range</span>
                <select id="datePresetSelect" class="bg-transparent font-body-sm text-body-sm font-semibold text-on-surface focus:outline-none cursor-pointer pr-1">
                    <option value="365">Son 12 Ay</option>
                    <option value="30">Son 30 Gün</option>
                    <option value="90">Son 3 Ay</option>
                    <option value="180">Son 6 Ay</option>
                    <option value="all">Tüm Zamanlar (2023 - 2026)</option>
                </select>
            </div>

            <div class="h-6 w-px bg-surface-container-high mx-1"></div>

            <button type="button" onclick="submitDateFilter()" class="px-space-md py-1.5 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold shadow-sm hover:opacity-95 transition-all flex items-center gap-1 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">tune</span>
                Uygula
            </button>

            <a href="@Url.Action("Index", "Dashboard")" class="px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low font-body-sm text-body-sm transition-all flex items-center" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
            </a>
        </form>
    </div>
</div>

@await Component.InvokeAsync("_PanelDashboardKpiCards", new { startDate = Model?.StartDate, endDate = Model?.EndDate })

<div class="grid grid-cols-1 xl:grid-cols-12 gap-gutter mb-space-xl">
    @await Component.InvokeAsync("_PanelDashboardDualAxisTrendChart", new { startDate = Model?.StartDate, endDate = Model?.EndDate })
    @await Component.InvokeAsync("_PanelDashboardVisualDonutChart", new { startDate = Model?.StartDate, endDate = Model?.EndDate })
</div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-space-xl">
    @await Component.InvokeAsync("_PanelDashboardCategoryPerformance", new { startDate = Model?.StartDate, endDate = Model?.EndDate })
    @await Component.InvokeAsync("_PanelDashboardRegionalDistribution", new { startDate = Model?.StartDate, endDate = Model?.EndDate })
</div>

<div id="top-selling-container">
    @await Component.InvokeAsync("_PanelDashboardTopSellingProducts")
</div>


<script>
    function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function submitDateFilter() {
        const selectedValue = document.getElementById('datePresetSelect').value;
        const hiddenStart = document.getElementById('hiddenStartDate');
        const hiddenEnd = document.getElementById('hiddenEndDate');

        const now = new Date();
        hiddenEnd.value = formatDate(now);

        if (selectedValue === 'all') {
            hiddenStart.value = '2023-01-01';
        } else {
            const days = parseInt(selectedValue, 10);
            const pastDate = new Date();
            pastDate.setDate(now.getDate() - days);
            hiddenStart.value = formatDate(pastDate);
        }

        document.getElementById('filterForm').submit();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        const start = urlParams.get('startDate');
        const end = urlParams.get('endDate');
        const select = document.getElementById('datePresetSelect');

        if (!start || !end) {
            select.value = "365";
            return;
        }

        if (start === '2023-01-01') {
            select.value = "all";
            return;
        }

        const diffDays = Math.round((new Date(end) - new Date(start)) / (1000 * 60 * 60 * 24));
        if (diffDays <= 31) select.value = "30";
        else if (diffDays <= 95) select.value = "90";
        else if (diffDays <= 185) select.value = "180";
        else select.value = "365";
    });
</script>
