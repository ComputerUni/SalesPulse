@using SalesPulse.Core.DTOs.OrderExplorerDtos
@model OrderExplorerFilterDto

@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="flex flex-col w-full pb-2">
    <!-- Top Navigation & Action Header -->
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-space-lg mb-space-lg">
        <div class="flex flex-col">
            <div class="flex items-center gap-space-xs text-outline mt-5 mb-3">
                <span class="font-label-caps text-label-caps tracking-wider uppercase text-primary">Sipariş Kayıtları</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight flex items-center gap-3">Sipariş Yönetimi</h1>
        </div>
        <!-- Global CTA Buttons -->
        <div class="flex flex-wrap items-center gap-space-sm self-start xl:self-auto">
            <a asp-action="ExportCsv" asp-controller="Order"
               asp-all-route-data="@(new Dictionary<string, string?> 
               {
                    { "SearchTerm", Model.SearchTerm },
                    { "StartDate", Model.StartDate?.ToString("yyyy-MM-dd") },
                    { "EndDate", Model.EndDate?.ToString("yyyy-MM-dd") },
                    { "CityId", Model.CityId?.ToString() },
                    { "Status", Model.Status },
                    { "PaymentMethod", Model.PaymentMethod },
                    { "MinAmount", Model.MinAmount?.ToString() },
                    { "MaxAmount", Model.MaxAmount?.ToString() }
                })"
               class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-title-sm text-body-sm shadow-sm transition-all duration-200">
                <span class="material-symbols-outlined text-[19px] text-primary">cloud_download</span>
                <span>CSV İndir</span>
            </a>
        </div>
    </div>
    <!-- Comprehensive Filter Ribbon (Level 1 Surface) -->
    @await Component.InvokeAsync("_PanelOrderExplorerMetricCards", new { filter = Model })
    @await Component.InvokeAsync("_PanelOrderExplorerFilterRibbon", new { filter = Model })
    <!-- Metric Strip Highlight (Micro Contextual Ribbon) -->
    <!-- Main Split Canvas: Orders Table + Preview Drawer/Panel -->
    <div class="grid grid-cols-12 gap-6 items-start">
        @await Component.InvokeAsync("_PanelOrderExplorerTable", new { filter = Model })
        @await Component.InvokeAsync("_PanelOrderExplorerDetailDrawer")
    </div>
    <!-- Dynamic Notification Toast Container (Script Supported) -->
    <div class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none bg-inverse-surface text-inverse-on-surface px-space-lg py-3 rounded-xl shadow-xl flex items-center gap-3" id="toastNotification">
        <span class="material-symbols-outlined text-primary-container text-[20px]">check_circle</span>
        <span class="font-body-md text-body-sm font-medium" id="toastMessage">İşlem başarıyla kaydedildi.</span>
    </div>
</div>
<script>
    function openDrawer(orderId) {
        if (!orderId) return;

        const cleanCode = orderId.replace(/^#+/, '');

        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('orderCode', cleanCode);

        window.location.search = urlParams.toString();
    }

    function closeDrawer() {
        const drawer = document.getElementById('orderDrawer');
        if (drawer) {
            drawer.classList.add('hidden');
        }
    }

    function copyToClipboard(text, event) {
        if (event) event.stopPropagation();
        navigator.clipboard.writeText(text).then(() => {
            triggerNotification("Kopyalandı: " + text);
        }).catch(() => {
            triggerNotification("Panoya kopyalama hazır: " + text);
        });
    }

    function triggerNotification(msg) {
        const toast = document.getElementById('toastNotification');
        const toastMsg = document.getElementById('toastMessage');
        if (toast && toastMsg) {
            toastMsg.innerText = msg;
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }
    }
</script>

