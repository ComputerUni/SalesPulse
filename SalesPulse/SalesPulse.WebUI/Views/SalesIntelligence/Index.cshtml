@using SalesPulse.Core.DTOs.SalesIntelligenceDtos
@model SalesIntelligenceFilterDto

@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<section class="flex flex-col xl:flex-row xl:items-center justify-between gap-space-lg mb-8">
    <div class="flex flex-col gap-1 mt-3">
        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1">Gelişmiş Satış Analizi</h1>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-3xl">
            Veriler üzerinden karmaşık analitik sorgular, kohort analizi ve müşteri ciro dağılımı.
        </p>
    </div>
    <div class="flex flex-wrap items-center gap-space-sm">
        <div class="flex items-center bg-surface-container-low p-1 rounded-xl shadow-xs">
            <button class="px-space-md py-1.5 rounded-lg font-body-sm text-body-sm font-semibold bg-surface-container-lowest text-primary shadow-sm flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-primary">swap_horiz</span>
                2024 vs 2023
            </button>
            <button class="px-space-md py-1.5 rounded-lg font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors">
                Son 4 Çeyrek (QoQ)
            </button>
        </div>

    </div>
</section>

@await Component.InvokeAsync("_PanelSalesIntelligenceAnalyticsKpiCards", new { filter = Model })

@await Component.InvokeAsync("_PanelSalesIntelligenceTopRevenueCustomers")

<section class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg mb-10">

    @await Component.InvokeAsync("_PanelSalesIntelligenceCategoryHeatmap")

    <div class="lg:col-span-5 bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
        @await Component.InvokeAsync("_PanelSalesIntelligenceTopStarProducts")
    </div>
</section>

<section class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg mb-5">
    <div class="lg:col-span-7 bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm">

        @await Component.InvokeAsync("_PanelSalesIntelligenceCohortRetentionMatrix")

    </div>

    <div class="lg:col-span-5 bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">

        @await Component.InvokeAsync("_PanelSalesIntelligenceCityGrowthRates")

    </div>
</section>
